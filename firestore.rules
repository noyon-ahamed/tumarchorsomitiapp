rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user data
      allow read: if isAuthenticated();
      
      // Users can create their own profile
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own profile, or admins can update any profile
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Deposits collection
    match /deposits/{depositId} {
      // Anyone authenticated can read deposits
      allow read: if isAuthenticated();
      
      // Users can create deposits for themselves, admins can create for anyone
      allow create: if isAuthenticated() && 
                       (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can update their own deposits, admins can update any
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Only admins can delete deposits
      allow delete: if isAdmin();
    }
    
    // Loans collection
    match /loans/{loanId} {
      // Anyone authenticated can read loans
      allow read: if isAuthenticated();
      
      // Only admins can create loans
      allow create: if isAdmin();
      
      // Borrowers can view and update their loans, admins can do anything
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Only admins can delete loans
      allow delete: if isAdmin();
    }
    
    // Investments collection
    match /investments/{investmentId} {
      // Anyone authenticated can read investments
      allow read: if isAuthenticated();
      
      // Admins can create investments
      allow create: if isAdmin();
      
      // Investors can update their investments, admins can update any
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Only admins can delete investments
      allow delete: if isAdmin();
    }
    
    // Messages/Notifications collection
    match /messages/{messageId} {
      // Users can read their own messages
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Admins can create messages for anyone
      allow create: if isAdmin();
      
      // Users can update their own messages (mark as read), admins can update any
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Only admins can delete messages
      allow delete: if isAdmin();
    }
    
    // Notifications collection (if separate from messages)
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // System/Admins can create notifications
      allow create: if isAdmin();
      
      // Users can update their own notifications (mark as read)
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Users can delete their own notifications, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ==================== TRANSACTIONS COLLECTION ====================
    match /transactions/{transactionId} {
      // All authenticated users can read transactions
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete transactions
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== SETTINGS COLLECTION ====================
    match /settings/{settingId} {
      // All authenticated users can read settings
      allow read: if isAuthenticated();
      
      // Only admins can update settings
      allow write: if isAdmin();
    }
    
    // ==================== ADMIN COLLECTION ====================
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // ==================== PAYMENT SUBMISSIONS ====================
    match /payment_submissions/{submissionId} {
      // Users can read their own submissions, admin can read all
      allow read: if isAuthenticated();
      
      // Users can create payment submissions
      allow create: if isAuthenticated();
      
      // Only admin can approve/reject (update) submissions
      allow update: if isAdmin();
      
      // Only admin can delete submissions
      allow delete: if isAdmin();
    }
    
    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
